<UserControl x:Class="OpenBoardAnim.Views.SaveSceneTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="160" d:DesignWidth="360">
    <StackPanel Margin="20" Width="320" HorizontalAlignment="Center" VerticalAlignment="Top">
        <TextBlock Text="Save this scene to the template gallery so it can be reused as a starter layout in any project."
                   Style="{StaticResource TextBlockSubTitle}" TextWrapping="Wrap" Margin="0 0 0 10" FontSize="12"/>
        <hc:TextBox x:Name="NameTextBox" hc:InfoElement.Placeholder="Template name" Text="{Binding Name, Mode=TwoWay}"/>
        <Button Margin="0 16 0 0" HorizontalAlignment="Right" Style="{StaticResource ButtonPrimary}"
                Click="Save_Click" Content="Save"/>
    </StackPanel>
</UserControl>
