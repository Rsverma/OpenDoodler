<UserControl x:Class="OpenBoardAnim.Views.LibraryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:OpenBoardAnim.Models"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="950">
    <!--
        Bound directly to EditorLibraryViewModel (passed in as-is when opening this dialog -
        see EditorLibraryViewModel.ManageLibraryHandler) rather than a dedicated ViewModel,
        since it just needs the same Graphics collection, search/import/load-more commands,
        and cache reference the sidebar Library panel's Graphics tab already exposes. This is
        a bigger, dedicated surface for browsing/deleting the whole library, distinct from
        that tab's compact "drag graphics onto the canvas" purpose.
    -->
    <Grid Margin="20" Width="900" Height="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Manage every graphic saved to your library. Deleting one here only removes it from the library - copies already placed on a scene are unaffected."
                   TextWrapping="Wrap" Style="{StaticResource TextBlockSubTitle}" FontSize="12" Margin="0 0 0 12"/>
        <Grid Grid.Row="1" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <hc:TextBox Grid.Column="0" hc:InfoElement.Placeholder="Search graphics" Text="{Binding SearchText}" Margin="0 0 5 0"/>
            <Button Grid.Column="1" Padding="10 5" Margin="0 0 5 0" Style="{StaticResource ButtonPrimary}"
                    Command="{Binding SearchGraphicsCommand}" Content="{materialDesign:PackIcon search}" ToolTip="Search"/>
            <Button Grid.Column="2" Padding="10 5" Margin="0 0 5 0" Command="{Binding ImportGraphicsCommand}"
                    ToolTip="Import SVG graphics into the library" Content="Import Graphics"/>
            <Button Grid.Column="3" Padding="10 5" Command="{Binding CleanupInvalidGraphicsCommand}"
                    ToolTip="Scan the whole library and permanently remove any graphic that fails to load"
                    Content="{materialDesign:PackIcon Broom}"/>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding Graphics}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DrawingModel}">
                            <Border Margin="6" Width="140" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel Margin="8">
                                    <Border Height="100" Background="White" CornerRadius="4">
                                        <Image Margin="6">
                                            <Image.Source>
                                                <DrawingImage Drawing="{Binding ImgDrawingGroup}"/>
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0 6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource ButtonDanger}" Command="{Binding DeleteGraphicCommand}"
                                            ToolTip="Delete this graphic from the library" Content="Delete"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="1" Margin="0 6 0 0" Command="{Binding LoadMoreGraphicsCommand}" Content="Load More.."/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
