<UserControl x:Class="OpenBoardAnim.Views.ProjectSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utils="clr-namespace:OpenBoardAnim.Utils"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <UserControl.Resources>
        <utils:HexEqualsThicknessConverter x:Key="HexEqualsThicknessConverter"/>
        <utils:FriendlyEnumConverter x:Key="FriendlyEnumConverter"/>
        <utils:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibilityConverter"/>
        <utils:EnumNotEqualsVisibilityConverter x:Key="EnumNotEqualsVisibilityConverter"/>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14 10"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockSubTitle}">
            <Setter Property="Margin" Value="0 0 0 2"/>
        </Style>
        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
        </Style>
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            hc:ComboBox's nice bordered/themed look comes from its own implicit default style
            (matched by control type) - a Style targeting the plain ComboBox base type would
            replace that template outright instead of layering on top of it, so the shared
            look here is just a reusable ItemTemplate applied locally on each control instead.
        -->
        <DataTemplate x:Key="FriendlyEnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FriendlyEnumConverter}}"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Width="440" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Border Style="{StaticResource SettingsCardStyle}" Margin="0 8 0 8">
                <StackPanel>
                    <TextBlock Text="Background Music" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="Play a music track underneath the whole project." Style="{StaticResource SettingsHintStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Click="BrowseAudio_Click">Choose File...</Button>
                        <Button Margin="10 0 0 0" Style="{StaticResource ButtonDanger}" Click="ClearAudio_Click" ToolTip="Remove Music" Content="{materialDesign:PackIcon Close}"/>
                    </StackPanel>
                    <TextBlock Margin="0 6 0 0" Text="{Binding AudioPath, TargetNullValue='No music selected'}" ToolTip="{Binding AudioPath}" TextTrimming="CharacterEllipsis" FontSize="12" FontStyle="Italic"/>
                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <TextBlock Text="Volume" VerticalAlignment="Center" Width="55"/>
                        <Slider Width="180" Minimum="0" Maximum="100" VerticalAlignment="Center" Value="{Binding AudioVolume, Mode=TwoWay}"/>
                        <TextBlock Margin="10 0 0 0" VerticalAlignment="Center" Text="{Binding AudioVolume, StringFormat={}{0:0}%}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                        <TextBlock Text="Trim" VerticalAlignment="Center" Width="55"/>
                        <TextBlock Text="Start" VerticalAlignment="Center" FontSize="11" Margin="0 0 4 0"/>
                        <hc:NumericUpDown Width="65" Minimum="0" DecimalPlaces="1" ValueFormat="0.0" Value="{Binding AudioTrimStart, Mode=TwoWay}"/>
                        <TextBlock Text="End" VerticalAlignment="Center" FontSize="11" Margin="10 0 4 0"/>
                        <hc:NumericUpDown Width="65" Minimum="0" DecimalPlaces="1" ValueFormat="0.0" Value="{Binding AudioTrimEnd, Mode=TwoWay}"
                                          ToolTip="Seconds from the start of the file. 0 = play to the end."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="Entrance Style" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="How each graphic appears on screen when it's added to a scene." Style="{StaticResource SettingsHintStyle}"/>
                    <hc:ComboBox x:Name="EntranceStyleComboBox" Width="220" HorizontalAlignment="Left" ItemTemplate="{StaticResource FriendlyEnumItemTemplate}" SelectedItem="{Binding Settings.EntranceStyle, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}" Visibility="{Binding Settings.EntranceStyle, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=HandDrawn}">
                <StackPanel>
                    <TextBlock Text="Stroke" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="Pen color and thickness used for the hand-drawn animation." Style="{StaticResource SettingsHintStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding Settings.StrokeColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF000000}">
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF000000" Tag="#FF000000" Click="StrokeColor_Click"/>
                        </Border>
                        <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding Settings.StrokeColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FFE53935}">
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFE53935" Tag="#FFE53935" Click="StrokeColor_Click"/>
                        </Border>
                        <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding Settings.StrokeColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF1E88E5}">
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF1E88E5" Tag="#FF1E88E5" Click="StrokeColor_Click"/>
                        </Border>
                        <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding Settings.StrokeColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF43A047}">
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF43A047" Tag="#FF43A047" Click="StrokeColor_Click"/>
                        </Border>
                        <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding Settings.StrokeColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FFFB8C00}">
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFFB8C00" Tag="#FFFB8C00" Click="StrokeColor_Click"/>
                        </Border>
                        <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding Settings.StrokeColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF8E24AA}">
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF8E24AA" Tag="#FF8E24AA" Click="StrokeColor_Click"/>
                        </Border>
                        <Border BorderBrush="Black" CornerRadius="4" Padding="2" BorderThickness="{Binding Settings.StrokeColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF6D4C41}">
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF6D4C41" Tag="#FF6D4C41" Click="StrokeColor_Click"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <TextBlock Text="Width" VerticalAlignment="Center" Width="55"/>
                        <hc:NumericUpDown Width="100" Minimum="1" Maximum="20" Style="{StaticResource NumericUpDownPlus}" Value="{Binding Settings.StrokeWidth, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="Aspect Ratio" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="Canvas shape used by the editor, preview, and exported video." Style="{StaticResource SettingsHintStyle}"/>
                    <hc:ComboBox x:Name="AspectRatioComboBox" Width="220" HorizontalAlignment="Left" ItemTemplate="{StaticResource FriendlyEnumItemTemplate}" SelectedItem="{Binding Settings.AspectRatio, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="Scene Transitions" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="How the canvas changes when moving from one scene to the next." Style="{StaticResource SettingsHintStyle}"/>
                    <hc:ComboBox x:Name="SceneTransitionComboBox" Width="220" HorizontalAlignment="Left" ItemTemplate="{StaticResource FriendlyEnumItemTemplate}" SelectedItem="{Binding Settings.SceneTransition, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0"
                                Visibility="{Binding Settings.SceneTransition, Converter={StaticResource EnumNotEqualsVisibilityConverter}, ConverterParameter=None}">
                        <TextBlock Text="Duration" VerticalAlignment="Center" Width="55"/>
                        <hc:NumericUpDown Width="80" Minimum="0.1" Maximum="5" DecimalPlaces="1" ValueFormat="0.0"
                                          Value="{Binding Settings.TransitionDurationSeconds, Mode=TwoWay}"/>
                        <TextBlock Margin="6 0 0 0" VerticalAlignment="Center" Text="seconds" FontSize="11" Opacity="0.65"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
