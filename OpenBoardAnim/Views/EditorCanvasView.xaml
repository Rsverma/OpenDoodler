<UserControl x:Class="OpenBoardAnim.Views.EditorCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
             xmlns:local="clr-namespace:OpenBoardAnim.Views"
             xmlns:s="clr-namespace:OpenBoardAnim.Controls"
             xmlns:models="clr-namespace:OpenBoardAnim.Models"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- MoveThumb Template -->
        <ControlTemplate x:Key="MoveThumbTemplate" TargetType="{x:Type s:MoveThumb}">
            <Rectangle Fill="Transparent" Stroke="Transparent"/>
        </ControlTemplate>

        <!-- ResizeDecorator Template -->
        <ControlTemplate x:Key="ResizeDecoratorTemplate" TargetType="{x:Type Control}">
            <Grid>
                <s:ResizeThumb Width="7" Height="7" Cursor="SizeNWSE" Margin="0 0 -6 -6"
                       VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Grid>
        </ControlTemplate>


        <!-- Designer Item Template-->
        <ControlTemplate x:Key="DesignerItemTemplate" TargetType="ContentControl">
            <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContentControl}}}">
                <s:MoveThumb Template="{StaticResource MoveThumbTemplate}" Cursor="SizeAll"/>
                <Control Template="{StaticResource ResizeDecoratorTemplate}"/>
                <ContentPresenter Content="{TemplateBinding ContentControl.Content}"/>
            </Grid>
        </ControlTemplate>
        <DataTemplate DataType="{x:Type models:DrawingModel}">
            <Image IsHitTestVisible="False" Stretch="Uniform">
                <Image.Source>
                    <DrawingImage Drawing="{Binding ImgDrawingGroup}"/>
                </Image.Source>
            </Image>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:TextModel}">
            <Path Data="{Binding TextGeometry}" Fill="{Binding SelectedColor}" Stroke="{Binding SelectedColor}" StrokeThickness="1" Stretch="Uniform"/>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Background is explicit White rather than left to HandyControl's themed default -
         a plain ListBox otherwise picks up the dark skin's own background in Dark theme,
         which paints over (it's a child, so it renders after/on top of) the White canvas
         area behind it whenever the ItemsPanel Canvas itself doesn't fully cover it. -->
    <ListBox ItemsSource="{Binding SceneGraphics}" SelectionMode="Extended" Background="White"
             SelectedItem="{Binding DataContext.Actions.SelectedGraphic, RelativeSource={RelativeSource AncestorType={x:Type local:EditorView}}, Mode=TwoWay}"
             SelectionChanged="GraphicsListBox_SelectionChanged">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- Canvas never auto-sizes to its content (it always measures to 0x0
                     regardless of children), so without an explicit size it only rendered
                     wherever an ancestor happened to stretch it to a non-zero size - visible
                     once a graphic gave it something to be arranged around, collapsed back to
                     nothing (revealing the surrounding SimplePanel's Gray/dark background)
                     when the scene had none. Bind directly to the project's own canvas size
                     so it's always correctly sized regardless of content. -->
                <Canvas Background="White"
                        Width="{Binding DataContext.Actions.Project.Settings.EditorWidth, RelativeSource={RelativeSource AncestorType={x:Type local:EditorView}}}"
                        Height="{Binding DataContext.Actions.Project.Settings.EditorHeight, RelativeSource={RelativeSource AncestorType={x:Type local:EditorView}}}"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Canvas.Left" Value="{Binding X,Mode=TwoWay}"/>
                <Setter Property="Canvas.Top" Value="{Binding Y,Mode=TwoWay}"/>
                <!-- Collapsed (not just hidden) so a layer-panel visibility toggle removes it
                     from hit-testing too, not just from view. -->
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <ContentControl Template="{StaticResource DesignerItemTemplate}" Content="{Binding}"
                                PreviewMouseRightButtonDown="GraphicItem_PreviewMouseRightButtonDown"
                                Tag="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType={x:Type local:EditorView}}}">
                    <ContentControl.ContextMenu>
                        <!-- No explicit Width here (was 170) - letting the menu size to its own
                             content avoids a mismatch between a narrower-than-content constrained
                             width and the natural/measured width, which is the leading suspect for
                             why the Align submenu below was opening with a large gap instead of
                             flush against the main menu. -->
                        <ContextMenu>
                            <MenuItem Header="Copy" Icon="{materialDesign:PackIcon ContentCopy}"
                                      Command="{Binding PlacementTarget.Tag.CopyGraphicCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Cut" Icon="{materialDesign:PackIcon ContentCut}"
                                      Command="{Binding PlacementTarget.Tag.CutGraphicCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Duplicate" Icon="{materialDesign:PackIcon ContentDuplicate}"
                                      Command="{Binding PlacementTarget.Tag.DuplicateGraphicCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Move Up" Icon="{materialDesign:PackIcon ArrowUpBold}"
                                      Command="{Binding PlacementTarget.Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Move Down" Icon="{materialDesign:PackIcon ArrowDownBold}"
                                      Command="{Binding PlacementTarget.Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Group" Icon="{materialDesign:PackIcon Group}"
                                      Command="{Binding PlacementTarget.Tag.GroupGraphicsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Ungroup" Icon="{materialDesign:PackIcon Ungroup}"
                                      Command="{Binding PlacementTarget.Tag.UngroupGraphicsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Align">
                                <MenuItem Header="Align Left" Icon="{materialDesign:PackIcon AlignHorizontalLeft}"
                                          Command="{Binding PlacementTarget.Tag.AlignLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Align Center" Icon="{materialDesign:PackIcon AlignHorizontalCenter}"
                                          Command="{Binding PlacementTarget.Tag.AlignCenterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Align Right" Icon="{materialDesign:PackIcon AlignHorizontalRight}"
                                          Command="{Binding PlacementTarget.Tag.AlignRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Align Top" Icon="{materialDesign:PackIcon AlignVerticalTop}"
                                          Command="{Binding PlacementTarget.Tag.AlignTopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Align Middle" Icon="{materialDesign:PackIcon AlignVerticalCenter}"
                                          Command="{Binding PlacementTarget.Tag.AlignMiddleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Align Bottom" Icon="{materialDesign:PackIcon AlignVerticalBottom}"
                                          Command="{Binding PlacementTarget.Tag.AlignBottomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Locked" IsCheckable="True" IsChecked="{Binding IsLocked, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ToggleLockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Hide" Icon="{materialDesign:PackIcon EyeOff}"
                                      Command="{Binding PlacementTarget.Tag.HideGraphicCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Delete" Icon="{materialDesign:PackIcon Delete}"
                                      Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ContentControl.ContextMenu>
                </ContentControl>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>    
</UserControl>
