<hc:Window x:Class="OpenBoardAnim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenBoardAnim"
        xmlns:views="clr-namespace:OpenBoardAnim.Views"
        xmlns:vm="clr-namespace:OpenBoardAnim.ViewModels"
        xmlns:models="clr-namespace:OpenBoardAnim.Models"
        xmlns:utils="clr-namespace:OpenBoardAnim.Utils"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowState="Maximized"
        Closing="Window_Closing"
        mc:Ignorable="d" MinHeight="650" MinWidth="1200">
    <hc:Window.Resources>
        <utils:EnumEqualsBooleanConverter x:Key="EnumEqualsBooleanConverter"/>
    </hc:Window.Resources>
    <hc:Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Navigation.CurrentView.Actions.SaveProjectCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding Navigation.CurrentView.Actions.DeleteItemCommand}"/>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding Navigation.CurrentView.Actions.CopyGraphicCommand}"/>
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding Navigation.CurrentView.Actions.CutGraphicCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding Navigation.CurrentView.Actions.PasteGraphicCommand}"/>
        <KeyBinding Key="Left" Command="{Binding Navigation.CurrentView.Actions.NudgeSelectedGraphicCommand}" CommandParameter="Left"/>
        <KeyBinding Key="Right" Command="{Binding Navigation.CurrentView.Actions.NudgeSelectedGraphicCommand}" CommandParameter="Right"/>
        <KeyBinding Key="Up" Command="{Binding Navigation.CurrentView.Actions.NudgeSelectedGraphicCommand}" CommandParameter="Up"/>
        <KeyBinding Key="Down" Command="{Binding Navigation.CurrentView.Actions.NudgeSelectedGraphicCommand}" CommandParameter="Down"/>
        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding Navigation.CurrentView.Actions.NudgeSelectedGraphicCommand}" CommandParameter="Left"/>
        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding Navigation.CurrentView.Actions.NudgeSelectedGraphicCommand}" CommandParameter="Right"/>
        <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding Navigation.CurrentView.Actions.NudgeSelectedGraphicCommand}" CommandParameter="Up"/>
        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding Navigation.CurrentView.Actions.NudgeSelectedGraphicCommand}" CommandParameter="Down"/>
    </hc:Window.InputBindings>
    <hc:Window.NonClientAreaContent>
        <Grid VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button BorderThickness="0" VerticalAlignment="Stretch" Padding="0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Resources/App.ico" />
                            <TextBlock Margin="10 0" Style="{StaticResource TextBlockTitle}" Text="{Binding Title}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Menu FontSize="15" VerticalAlignment="Center">
                    <MenuItem Header="File">
                        <MenuItem Header="New Project" Icon="{materialDesign:PackIcon FilePlus}" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                        <MenuItem Header="Open Project" Icon="{materialDesign:PackIcon FolderOpen}" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Save Project" Icon="{materialDesign:PackIcon ContentSave}" Command="{Binding Navigation.CurrentView.Actions.SaveProjectCommand}" InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem Header="Exit" Icon="{materialDesign:PackIcon Logout}" Command="{Binding ExitCommand}"/>
                    </MenuItem>
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" Icon="{materialDesign:PackIcon Undo}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="Redo" Icon="{materialDesign:PackIcon Redo}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="Copy Graphic" Icon="{materialDesign:PackIcon ContentCopy}" Command="{Binding Navigation.CurrentView.Actions.CopyGraphicCommand}" InputGestureText="Ctrl+C"/>
                        <MenuItem Header="Cut Graphic" Icon="{materialDesign:PackIcon ContentCut}" Command="{Binding Navigation.CurrentView.Actions.CutGraphicCommand}" InputGestureText="Ctrl+X"/>
                        <MenuItem Header="Paste Graphic" Icon="{materialDesign:PackIcon ContentPaste}" Command="{Binding Navigation.CurrentView.Actions.PasteGraphicCommand}" InputGestureText="Ctrl+V"/>
                    </MenuItem>
                    <MenuItem Header="View">
                        <MenuItem Header="Light" IsCheckable="True" Icon="{materialDesign:PackIcon WhiteBalanceSunny}"
                                  IsChecked="{Binding Theme.CurrentTheme, Converter={StaticResource EnumEqualsBooleanConverter}, ConverterParameter=Light, Mode=OneWay}"
                                  Command="{Binding Theme.SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.Light}"/>
                        <MenuItem Header="Dark" IsCheckable="True" Icon="{materialDesign:PackIcon WeatherNight}"
                                  IsChecked="{Binding Theme.CurrentTheme, Converter={StaticResource EnumEqualsBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}"
                                  Command="{Binding Theme.SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.Dark}"/>
                        <MenuItem Header="Match System" IsCheckable="True" Icon="{materialDesign:PackIcon ThemeLightDark}"
                                  IsChecked="{Binding Theme.CurrentTheme, Converter={StaticResource EnumEqualsBooleanConverter}, ConverterParameter=System, Mode=OneWay}"
                                  Command="{Binding Theme.SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.System}"/>
                    </MenuItem>
                    <MenuItem Header="Help">
                        <MenuItem Header="About" Icon="{materialDesign:PackIcon Info}"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
            <TextBlock Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TextBlockSubTitleBold}" Text="{Binding ProjectStatusText}"/>
            <StackPanel Orientation="Horizontal" Grid.Column="2">
                <Button Content="{Binding UserName}"/>

            </StackPanel>
        </Grid>
    </hc:Window.NonClientAreaContent>
    <ContentControl Grid.Row="2" Content="{Binding Path = Navigation.CurrentView}"/>
    
</hc:Window>
    
