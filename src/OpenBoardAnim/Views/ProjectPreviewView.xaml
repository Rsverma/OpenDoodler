<UserControl x:Class="OpenBoardAnim.Views.ProjectPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenBoardAnim.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="1">
            <Canvas Margin="10" Background="White" Width="{Binding Settings.EditorWidth}" Height="{Binding Settings.EditorHeight}" x:Name="PreviewCanvas">
            </Canvas>
        </Border>
        <!--
            Scrub timeline: TimelineSlider drives PreviewPlaybackHandler.Seek directly (both for a
            drag and for a plain track click, both of which start with PreviewMouseLeftButtonDown -
            see ProjectPreviewView.xaml.cs). Playback pauses for the duration of a
            down-then-up on the slider and resumes afterward only if it was already playing, so
            scrubbing while playing doesn't fight the auto-advancing position.
        -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 10" HorizontalAlignment="Center">
            <Button x:Name="PlayPauseButton" Width="60" Content="Play" Click="PlayPauseButton_Click"/>
            <Slider x:Name="TimelineSlider" Width="360" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" Margin="10 0"
                    PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                    ValueChanged="TimelineSlider_ValueChanged"/>
            <TextBlock x:Name="TimeLabel" Text="0:00 / 0:00" VerticalAlignment="Center" Width="90"/>
        </StackPanel>
    </Grid>
</UserControl>
