<UserControl x:Class="OpenBoardAnim.Views.EditorTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:OpenBoardAnim.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OpenBoardAnim.Views"
             xmlns:utils="clr-namespace:OpenBoardAnim.Utils"
             xmlns:controls="clr-namespace:OpenBoardAnim.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ControlTemplate x:Key="DesignerItemTemplate" TargetType="ContentControl">
            <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContentControl}}}">

                <ContentPresenter Content="{TemplateBinding ContentControl.Content}"/>
            </Grid>
        </ControlTemplate>
        <DataTemplate DataType="{x:Type models:DrawingModel}">
            <Image IsHitTestVisible="False">
                <Image.Source>
                    <DrawingImage Drawing="{Binding ImgDrawingGroup}"/>
                </Image.Source>
            </Image>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:TextModel}">
            <Path Data="{Binding TextGeometry}" Fill="{Binding SelectedColor}" Stroke="{Binding SelectedColor}" StrokeThickness="1"/>
        </DataTemplate>
        <utils:ResizeConverter x:Key="ResizeConverter"/>
        <utils:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <utils:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <utils:SubtractHalfConverter x:Key="SubtractHalfConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="SceneCardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderThickness="0 1 0 0" BorderBrush="Black">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10 4 10 0">
                <Button Padding="4" Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out" Content="{materialDesign:PackIcon MagnifyMinus}"/>
                <TextBlock Text="{Binding ZoomPercentageText}" Width="42" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                <Button Padding="4" Command="{Binding ZoomInCommand}" ToolTip="Zoom In" Content="{materialDesign:PackIcon MagnifyPlus}"/>
                <Button Margin="8 0 0 0" Padding="4" Command="{Binding ResetZoomCommand}" ToolTip="Reset Zoom" Content="{materialDesign:PackIcon Restore}"/>
            </StackPanel>
            <DockPanel Margin="10 4 10 16" LastChildFill="True">
                <!-- Track-header column: a fixed (non-scrolling) icon per timeline row, aligned
                     to the same Canvas.Top offsets as their data rows below via the shared
                     EditorTimelineViewModel.TimelineCanvasHeight constant, so the two Canvases
                     can't drift apart. Order matches the rows: audio (voiceover), effects
                     (camera), graphics (scenes), music. -->
                <Canvas DockPanel.Dock="Left" Width="24" Height="{Binding TimelineCanvasHeight}">
                    <materialDesign:PackIcon Kind="Microphone" Width="14" Height="14" Canvas.Left="5" Canvas.Top="22"
                                              Opacity="0.55" ToolTip="Audio (voiceover) track"/>
                    <!-- Divider lines between each icon, at the midpoint of the gap between its
                         row and the next - matching the row boundaries in EditorTimelineViewModel
                         (see TimelineCanvasHeight). -->
                    <Rectangle Canvas.Top="39" Canvas.Left="0" Width="24" Height="1" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.2"/>
                    <materialDesign:PackIcon Kind="MovieFilter" Width="13" Height="13" Canvas.Left="5.5" Canvas.Top="42"
                                              Opacity="0.55" ToolTip="Camera effects track"/>
                    <Rectangle Canvas.Top="57" Canvas.Left="0" Width="24" Height="1" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.2"/>
                    <materialDesign:PackIcon Kind="ImageMultiple" Width="16" Height="16" Canvas.Left="4" Canvas.Top="93"
                                              Opacity="0.55" ToolTip="Graphics (scenes) track"/>
                    <Rectangle Canvas.Top="146" Canvas.Left="0" Width="24" Height="1" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.2"/>
                    <materialDesign:PackIcon Kind="MusicNote" Width="14" Height="14" Canvas.Left="5" Canvas.Top="152"
                                              Opacity="0.55" ToolTip="Background music track"/>
                </Canvas>
                <!-- Vertical divider separating the icon column from the scrollable timeline. -->
                <Border DockPanel.Dock="Left" Width="1" Height="{Binding TimelineCanvasHeight}" Margin="4 0 6 0"
                        Background="{DynamicResource PrimaryTextBrush}" Opacity="0.2"/>
                <ScrollViewer x:Name="TimelineScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">
            <!-- HorizontalAlignment="Left" - without it, WPF's layout system centers an element
                 with an explicit Width (like this one, bound to TotalWidth) within whatever
                 extra space its container gives it, so a short timeline (few/short scenes,
                 zoomed out) would float away from the icon column instead of starting right
                 after it. -->
            <Canvas Width="{Binding TotalWidth}" Height="{Binding TimelineCanvasHeight}" HorizontalAlignment="Left">
                <!-- Time ruler: labeled tick marks (seconds, mm:ss) spaced from
                     EditorTimelineViewModel.TimeRulerTicks, which already picks a "nice"
                     interval for the current zoom - purely a navigational scale, not
                     reconciled against individual (possibly width-floored) segment widths. -->
                <ItemsControl ItemsSource="{Binding TimeRulerTicks}" Canvas.Left="0" Canvas.Top="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TimeRulerTick}">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource PrimaryTextBrush}"
                                           Opacity="0.7" Width="40" Margin="-20 0 0 0" TextAlignment="Center"/>
                                <Rectangle Width="1" Height="6" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.35" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Voiceover layer: one bar per scene, above the cards, only visible for scenes that have one set -->
                <ItemsControl ItemsSource="{Binding Segments}" Canvas.Left="0" Canvas.Top="20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SceneTimelineSegment}">
                            <Border Width="{Binding Width}" Height="18" CornerRadius="4" Background="#FF8E24AA"
                                    Visibility="{Binding Scene.VoiceoverPath, Converter={StaticResource NullToVisibilityConverter}}"
                                    ToolTip="{Binding Scene.VoiceoverPath}" ClipToBounds="True">
                                <Grid>
                                    <controls:WaveformControl AudioPath="{Binding Scene.VoiceoverPath}" WaveformBrush="#66FFFFFF" Margin="2 0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Microphone" Width="12" Height="12" Foreground="White" Margin="0 0 3 0"/>
                                        <TextBlock Text="Voiceover" FontSize="9" Foreground="White"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Camera effects layer: one strip per scene, showing each effect's position/duration within it -->
                <ItemsControl ItemsSource="{Binding Segments}" Canvas.Left="0" Canvas.Top="40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SceneTimelineSegment}">
                            <Canvas Width="{Binding Width}" Height="16"
                                    Visibility="{Binding Scene.CameraEffects.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding CameraEffectBlocks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:CameraEffectTimelineBlock}">
                                            <Border Width="{Binding Width}" Height="16" CornerRadius="3" Background="#FF1E88E5"
                                                    ToolTip="{Binding ToolTipText}" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Effect.EditEffectCommand}"/>
                                                </Border.InputBindings>
                                                <materialDesign:PackIcon Kind="Video" Width="10" Height="10" Foreground="White"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Background music layer: one bar spanning every real scene, below the cards.
                     Height is 20% taller than the other track bars (18 -> 22px) for visual
                     emphasis - the graphics/scenes track below is shrunk by the same 4px to
                     compensate, keeping TimelineCanvasHeight unchanged. -->
                <Border Canvas.Left="0" Canvas.Top="148" Width="{Binding RealContentWidth}" Height="22" CornerRadius="4" Background="#FF43A047"
                        Visibility="{Binding Project.AudioPath, Converter={StaticResource NullToVisibilityConverter}}"
                        ToolTip="{Binding Project.AudioPath}" ClipToBounds="True">
                    <Grid>
                        <controls:WaveformControl AudioPath="{Binding Project.AudioPath}" WaveformBrush="#66FFFFFF" Margin="2 0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8 0 0 0">
                            <materialDesign:PackIcon Kind="MusicNote" Width="12" Height="12" Foreground="White" Margin="0 0 4 0"/>
                            <TextBlock Text="Background Music" FontSize="9" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- AllowDrop/DragOver/Drop here (not on each card) so a card dropped anywhere
                     within another card's bounds still resolves to that card via DataContext
                     hit-testing in the Drop handler - simpler than tracking per-card drop zones. -->
                <ItemsControl ItemsSource="{Binding Segments}" Canvas.Left="0" Canvas.Top="58"
                              AllowDrop="True" DragOver="ScenesItemsControl_DragOver" Drop="ScenesItemsControl_Drop">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SceneTimelineSegment}">
                            <!-- PreviewMouseLeftButtonDown/PreviewMouseMove initiate a drag past
                                 a movement threshold, without ever marking the event Handled, so
                                 a plain click still reaches MouseLeftButtonDown below and selects
                                 normally - dragging only kicks in once the mouse actually moves. -->
                            <Border Width="{Binding Width}" Height="86" Style="{StaticResource SceneCardBorderStyle}"
                                    MouseLeftButtonDown="SceneCard_MouseLeftButtonDown"
                                    PreviewMouseLeftButtonDown="SceneCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="SceneCard_PreviewMouseMove"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:EditorTimelineView}}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.ColumnSpan="3" Fill="#11000000" Margin="4" RadiusX="6" RadiusY="6"/>
                                    <Grid Grid.Column="1">
                                        <ListBox ItemsSource="{Binding Scene.Graphics}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Background="White"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Canvas.Left" Value="{Binding X,Converter={StaticResource ResizeConverter},Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y,Converter={StaticResource ResizeConverter},Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Setter Property="Width" Value="{Binding Width,Converter={StaticResource ResizeConverter},Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Setter Property="Height" Value="{Binding Height,Converter={StaticResource ResizeConverter},Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <ContentControl Template="{StaticResource DesignerItemTemplate}" Content="{Binding}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></TextBlock>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Scene.Name}"></TextBlock>
                                        <materialDesign:PackIcon Kind="Microphone" Width="14" Height="14" Margin="0 0 4 4"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                  Foreground="Black"
                                                                  ToolTip="This scene has a voiceover"
                                                                  Visibility="{Binding Scene.VoiceoverPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <materialDesign:PackIcon Kind="Video" Width="14" Height="14" Margin="0 0 22 4"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                  Foreground="Black"
                                                                  ToolTip="This scene has camera effects"
                                                                  Visibility="{Binding Scene.CameraEffects.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                    </Grid>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu Width="170">
                                        <MenuItem Header="Preview Scene" Icon="{materialDesign:PackIcon Play}"
                                                  Command="{Binding PlacementTarget.Tag.PreviewSceneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding Scene}"/>
                                        <MenuItem Header="Add Camera Effect" Icon="{materialDesign:PackIcon Video}"
                                                  Command="{Binding PlacementTarget.Tag.AddCameraEffectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding Scene}"/>
                                        <Separator />
                                        <MenuItem Header="Move Left" Icon="{materialDesign:PackIcon arrowleft}" Command="{Binding Scene.SceneLeftCommand}"/>
                                        <MenuItem Header="Move Right" Icon="{materialDesign:PackIcon arrowright}" Command="{Binding Scene.SceneRightCommand}"/>
                                        <Separator />
                                        <MenuItem Header="Duplicate" Icon="{materialDesign:PackIcon shape}" Command="{Binding Scene.SceneDuplicateCommand}"/>
                                        <Separator />
                                        <MenuItem Header="Set Voiceover..." Icon="{materialDesign:PackIcon microphone}" Click="SetVoiceover_Click"/>
                                        <MenuItem Header="Clear Voiceover" Icon="{materialDesign:PackIcon microphoneOff}" Click="ClearVoiceover_Click"/>
                                        <Separator />
                                        <MenuItem Header="Delete"  Icon="{materialDesign:PackIcon delete}" Command="{Binding Scene.SceneDeleteCommand}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Scene-to-scene transition markers, filling the gap between two adjacent
                     scene cards - only present at a boundary whose effective transition (this
                     scene's own override, or the project default if it inherits) isn't None.
                     Width is sized to TransitionDurationSeconds at the current zoom (see
                     EditorTimelineViewModel.RecomputeSegments), the same way a scene card's own
                     width stands in for its estimated duration. -->
                <ItemsControl ItemsSource="{Binding TransitionBlocks}" Canvas.Left="0" Canvas.Top="91">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SceneTransitionTimelineBlock}">
                            <!-- Orange marks a scene's own override; blue-gray marks a transition
                                 that's simply inheriting the project's default. -->
                            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="10" ToolTip="{Binding ToolTipText}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFFF9800"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverride}" Value="False">
                                                <Setter Property="Background" Value="#FF546E7A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="13" Height="13" Foreground="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Thumb Canvas.Left="{Binding PlayheadX, Converter={StaticResource SubtractHalfConverter}, ConverterParameter=12}"
                       Canvas.Top="0" Width="12" Height="{Binding TimelineCanvasHeight}" Cursor="SizeWE"
                       DragDelta="Playhead_DragDelta" DragCompleted="Playhead_DragCompleted"
                       ToolTip="Drag to jump between scenes">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Width="12" Background="Transparent">
                                <Rectangle Width="2" Fill="#FFE53935" HorizontalAlignment="Center"/>
                                <Polygon Points="0,0 12,0 6,10" Fill="#FFE53935" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Canvas>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
