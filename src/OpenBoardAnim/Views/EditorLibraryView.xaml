<UserControl x:Class="OpenBoardAnim.Views.EditorLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:OpenBoardAnim.Views"
             xmlns:models="clr-namespace:OpenBoardAnim.Models"
             xmlns:utils="clr-namespace:OpenBoardAnim.Utils"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <utils:ResizeConverter x:Key="ResizeConverter"/>
        <utils:HexEqualsThicknessConverter x:Key="HexEqualsThicknessConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- HandyControl's implicit ToggleButton style doesn't give IsChecked a visible highlight
             on its own (same "own ControlTemplate needed to see a state change" issue as the
             Border-highlight/tile-Height fixes elsewhere in this app) - this bypasses it with a
             plain Border whose Background/BorderBrush react to IsChecked directly. -->
        <Style x:Key="FormatToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- The bypassed ControlTemplate below has no themed chrome of its own to supply a
                 Foreground, so without this the Content (a plain "B"/"I" string or a child
                 TextBlock, both of which inherit Foreground rather than setting it) fell back to
                 the WPF default of black regardless of theme. -->
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Style.Triggers (not ControlTemplate.Triggers) so this can set the
                     ToggleButton's own Foreground DP directly - the Border in the template above
                     has no Foreground property to target. White keeps the "B"/"I"/"U"/"S" glyph
                     readable once the Background switches to the (typically saturated) accent
                     PrimaryBrush above. -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Non-interactive (no move/resize thumbs) content-only template, just for rendering a
             read-only thumbnail preview of a template's graphics - same technique the timeline's
             own scene cards already use. -->
        <ControlTemplate x:Key="DesignerItemTemplate" TargetType="ContentControl">
            <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContentControl}}}">
                <ContentPresenter Content="{TemplateBinding ContentControl.Content}"/>
            </Grid>
        </ControlTemplate>
        <DataTemplate DataType="{x:Type models:DrawingModel}">
            <Image IsHitTestVisible="False">
                <Image.Source>
                    <DrawingImage Drawing="{Binding ImgDrawingGroup}"/>
                </Image.Source>
            </Image>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:TextModel}">
            <Path Data="{Binding TextGeometry}" Fill="{Binding SelectedColor}" Stroke="{Binding SelectedColor}" StrokeThickness="1"/>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{DynamicResource RegionBrush}" Width="300" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <hc:TabControl Grid.Row="1" IsAnimationEnabled="True" IsDraggable="True" IsTabFillEnabled="True" TabItemWidth="20">
                <hc:TabItem Header="{materialDesign:PackIcon imageFrame}" ToolTip="Scenes" ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Margin="5" HorizontalAlignment="Stretch" Command="{Binding SaveCurrentSceneAsTemplateCommand}"
                                ToolTip="Add the currently selected scene to this gallery for reuse" Content="Save Current Scene as Template"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
                            <ListBox ItemsSource="{Binding SceneTemplates}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SceneTemplateModel}">
                                        <Border Margin="5" Width="160" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <Border Height="90" Background="White" CornerRadius="5 5 0 0" ClipToBounds="True">
                                                    <ListBox ItemsSource="{Binding Scene.Graphics}" IsHitTestVisible="False"
                                                             BorderThickness="0" Background="Transparent">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Canvas.Left" Value="{Binding X,Converter={StaticResource ResizeConverter},Mode=OneWay}"/>
                                                                <Setter Property="Canvas.Top" Value="{Binding Y,Converter={StaticResource ResizeConverter},Mode=OneWay}"/>
                                                                <Setter Property="Width" Value="{Binding Width,Converter={StaticResource ResizeConverter},Mode=OneWay}"/>
                                                                <Setter Property="Height" Value="{Binding Height,Converter={StaticResource ResizeConverter},Mode=OneWay}"/>
                                                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <ContentControl Template="{StaticResource DesignerItemTemplate}" Content="{Binding}"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="4" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 6">
                                                    <Button Padding="10 2" Style="{StaticResource ButtonPrimary}" Command="{Binding InsertTemplateCommand}"
                                                            ToolTip="Insert as a new scene" Content="Use"/>
                                                    <Button Margin="4 0 0 0" Padding="6 2" Style="{StaticResource ButtonDanger}" Command="{Binding DeleteTemplateCommand}"
                                                            ToolTip="Delete this template" Content="{materialDesign:PackIcon Delete}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </hc:TabItem>
                <hc:TabItem IsSelected="True" Header="{materialDesign:PackIcon AccountGroup}" ToolTip="Graphics">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <hc:TextBox hc:InfoElement.Placeholder="Search graphics" Text="{Binding SearchText}" Grid.Column="0" Margin="2.5 5"/>
                        <Button Grid.Column="1" Padding="5" Margin="2.5 5" Command="{Binding SearchGraphicsCommand}" Style="{StaticResource ButtonPrimary}" Content="{materialDesign:PackIcon search}" ToolTip="Search"/>
                        <Button Grid.Column="2" Padding="5" Margin="2.5 5" Command="{Binding ManageLibraryCommand}" Content="{materialDesign:PackIcon FolderCog}" ToolTip="Manage Library"/>
                        <ScrollViewer x:Name="GraphicsScrollViewer" Grid.Row="1" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Visible">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="GraphicsListBox_PreviewMouseWheel"
                                         ItemsSource="{Binding Graphics}" SelectedItem="{Binding SelectedGraphic}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Name}" Margin="5" Orientation="Vertical">
                                                <Image Height="115" Width="115">
                                                    <Image.Source>
                                                        <DrawingImage Drawing="{Binding ImgDrawingGroup}"/>
                                                    </Image.Source>
                                                </Image>
                                                <Button Margin="0 10 0 0" Style="{StaticResource ButtonPrimary}" Command="{Binding AddGraphicCommand}">Add</Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="1" Command="{Binding LoadMoreGraphicsCommand}"
                                        Visibility="{Binding CanLoadMoreGraphics, Converter={StaticResource BoolToVisConverter}}">Load More..</Button>
                            </Grid>
                        </ScrollViewer>
                        
                    </Grid>
                </hc:TabItem>
                <hc:TabItem Header="{materialDesign:PackIcon shape}" ToolTip="Shapes">
                    <ListBox ScrollViewer.VerticalScrollBarVisibility="Visible"  ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding Name}" Margin="5" Orientation="Vertical">
                                    <Image Height="115" Width="115">
                                        <Image.Source>
                                            <DrawingImage Drawing="{Binding ImgDrawingGroup}"/>
                                        </Image.Source>
                                    </Image>
                                    <Button Margin="0 10 0 0" Style="{StaticResource ButtonPrimary}" Command="{Binding AddGraphicCommand}">Add</Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </hc:TabItem>
                <hc:TabItem Header="{materialDesign:PackIcon FormatLetterCase}" ToolTip="Text">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="5 5 2 5" Text="Text" VerticalAlignment="Center"/>
                        <TextBlock Margin="5 5 2 5" Text="Font Family" Grid.Row="1" VerticalAlignment="Center"/>
                        <TextBlock Margin="5 5 2 5" Text="Font Style" Grid.Row="2" VerticalAlignment="Center"/>
                        <TextBlock Margin="5 5 2 5" Text="Color" Grid.Row="3" VerticalAlignment="Center"/>
                        <TextBlock Margin="5 5 2 5" Text="Font Size" Grid.Row="4" VerticalAlignment="Center"/>
                        <StackPanel Margin="5 5 2 5" Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                <ToggleButton x:Name="boldToggle" Style="{StaticResource FormatToggleButtonStyle}" Content="B" FontWeight="Bold" Click="BoldToggle_Click"/>
                                <ToggleButton x:Name="italicToggle" Style="{StaticResource FormatToggleButtonStyle}" Margin="4 0 0 0" Content="I" FontStyle="Italic" Click="ItalicToggle_Click"/>
                                <ToggleButton x:Name="underlineToggle" Style="{StaticResource FormatToggleButtonStyle}" Margin="4 0 0 0" Click="UnderlineToggle_Click">
                                    <TextBlock Text="U" TextDecorations="Underline"/>
                                </ToggleButton>
                                <ToggleButton x:Name="strikethroughToggle" Style="{StaticResource FormatToggleButtonStyle}" Margin="4 0 0 0" Click="StrikethroughToggle_Click">
                                    <TextBlock Text="S" TextDecorations="Strikethrough"/>
                                </ToggleButton>
                            </StackPanel>
                            <RichTextBox x:Name="textRichTextBox" Height="60" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="{Binding SelectedFontFamily}"
                                         FontStyle="{Binding SelectedTypeFace.Style}"
                                         FontWeight="{Binding SelectedTypeFace.Weight}"
                                         FontSize="{Binding FontSize}"
                                         SelectionChanged="TextRichTextBox_SelectionChanged"
                                         TextChanged="TextRichTextBox_TextChanged"/>
                        </StackPanel>
                        <hc:ComboBox x:Name="fontSelector" Margin="5 5 2 5" Grid.Column="1" Grid.Row="1"
                                     ItemsSource="{x:Static Fonts.SystemFontFamilies}" SelectedItem="{Binding SelectedFontFamily}"/>
                        <hc:ComboBox x:Name="typefaceSelector" Margin="5 5 2 5" Grid.Column="1" Grid.Row="2"
                                     ItemsSource="{Binding SelectedItem.FamilyTypefaces, ElementName=fontSelector}" DisplayMemberPath="AdjustedFaceNames[en-US]"
                                     SelectedItem="{Binding SelectedTypeFace}"/>
                        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal" Margin="5 5 2 5">
                            <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding SelectedTextColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF000000}">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF000000" Tag="#FF000000" Click="TextColor_Click"/>
                            </Border>
                            <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding SelectedTextColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FFE53935}">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFE53935" Tag="#FFE53935" Click="TextColor_Click"/>
                            </Border>
                            <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding SelectedTextColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF1E88E5}">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF1E88E5" Tag="#FF1E88E5" Click="TextColor_Click"/>
                            </Border>
                            <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding SelectedTextColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF43A047}">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF43A047" Tag="#FF43A047" Click="TextColor_Click"/>
                            </Border>
                            <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding SelectedTextColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FFFB8C00}">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFFB8C00" Tag="#FFFB8C00" Click="TextColor_Click"/>
                            </Border>
                            <Border BorderBrush="Black" CornerRadius="4" Padding="2" Margin="0 0 6 0" BorderThickness="{Binding SelectedTextColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF8E24AA}">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF8E24AA" Tag="#FF8E24AA" Click="TextColor_Click"/>
                            </Border>
                            <Border BorderBrush="Black" CornerRadius="4" Padding="2" BorderThickness="{Binding SelectedTextColorHex, Converter={StaticResource HexEqualsThicknessConverter}, ConverterParameter=#FF6D4C41}">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF6D4C41" Tag="#FF6D4C41" Click="TextColor_Click"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" Margin="5 5 2 5">
                            <hc:NumericUpDown x:Name="sizeSelector" Minimum="1" Value="{Binding FontSize}"/>
                        </StackPanel>
                        <Button Margin="5 5 2 5" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" Style="{DynamicResource ButtonPrimary}"
                                 Command="{Binding AddTextCommand}" Click="AddText_Click" Content ="Add Text"/>
                    </Grid>
                </hc:TabItem>
                <hc:TabItem Header="{materialDesign:PackIcon music}" ToolTip="Audio">
                    <TextBlock Text="Under&#x0a;construction" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"/>
                </hc:TabItem>
                <hc:TabItem Header="{materialDesign:PackIcon CloudUpload}">
                    <TextBlock Text="Under&#x0a;construction" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"/>
                </hc:TabItem>
            </hc:TabControl>
        </Grid>
    </Border>
</UserControl>
